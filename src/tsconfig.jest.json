{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@moderanger/core": ["packages/core/src/index.ts"],
      "@moderanger/core/*": ["packages/core/src/*"],
      "@angular/cdk/tree": ["node_modules/@angular/cdk/types/tree.d.ts"],
      "@angular/cdk/overlay": ["node_modules/@angular/cdk/types/overlay.d.ts"],
      "primeng/*": ["node_modules/primeng/types/primeng-*.d.ts"]
    },
    "types": [
      "jest",
      "node"
    ],
    "typeRoots": [
      "../node_modules/@types"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": [
    "**/*.jest.spec.ts",
    "**/__mocks__/**/*.ts",
    "jest.setup.ts",
    "**/*.d.ts"
  ]
}
